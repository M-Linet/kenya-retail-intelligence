	partition fact_sales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_sales.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"transaction_item_id", Int64.Type}, {"transaction_id", type text}, {"sale_date", type date}, {"sale_hour", Int64.Type}, {"branch_id", type text}, {"product_id", type text}, {"customer_key", type text}, {"payment_method", type text}, {"promotion_id", type text}, {"price_type", type text}, {"quantity", Int64.Type}, {"gross_sales", Currency.Type}, {"discount_amount", Currency.Type}, {"net_revenue", Currency.Type}, {"cogs", Currency.Type}, {"gross_profit", Currency.Type}}, "en-US")
				in
				    Typed

