	partition dim_branch = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_branch.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"branch_id", type text}, {"branch_name", type text}, {"branch_short", type text}, {"county", type text}, {"town", type text}, {"branch_type", type text}, {"opening_date", type date}, {"is_like_for_like", type logical}}, "en-US")
				in
				    Typed

