{
  "name": "Savanna Fresh Analytics",
  "dataColors": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948"],
  "foreground": "#2b2b29",
  "foregroundNeutralSecondary": "#6b6a64",
  "background": "#ffffff",
  "backgroundLight": "#f7f7f4",
  "tableAccent": "#2a78d6",
  "good": "#1baf7a",
  "neutral": "#eda100",
  "bad": "#e34948",
  "maximum": "#0d366b",
  "center": "#6da7ec",
  "minimum": "#cde2fb",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#2b2b29" },
    "label": { "fontFace": "Segoe UI", "fontSize": 9, "color": "#6b6a64" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 24, "color": "#2b2b29" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [{ "show": false }],
        "background": [{ "show": true, "color": { "solid": { "color": "#ffffff" } } }],
        "title": [{ "show": true, "alignment": "left", "fontSize": 11 }]
      }
    },
    "page": { "*": { "background": [{ "color": { "solid": { "color": "#f7f7f4" } }, "transparency": 0 }] } }
  }
}
