		summarizeBy: none
		sourceColumn: branch_name

	column branch_short
		dataType: string
		lineageTag: 272c4b35-371e-5f51-8adf-4b82fdb5b63e
		summarizeBy: none
		sourceColumn: branch_short

	column county
		dataType: string
		lineageTag: 5b60db8d-1906-5ac6-a142-8bbe8b224f8d
