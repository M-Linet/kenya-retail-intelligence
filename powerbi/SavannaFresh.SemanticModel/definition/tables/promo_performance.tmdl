	partition promo_performance = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "promo_performance.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"promotion_id", type text}, {"product_id", type text}, {"product_name", type text}, {"category", type text}, {"start_date", type date}, {"days", Int64.Type}, {"discount_percentage", type number}, {"baseline_units_per_day", type number}, {"promo_units_per_day", type number}, {"unit_uplift_pct", type number}, {"discount_cost_kes", Currency.Type}, {"incremental_gp_kes", Currency.Type}, {"outcome", type text}}, "en-US")
				in
				    Typed

