table _Measures
	lineageTag: dbd6b562-3f45-5990-942d-de8a1e92727a

	measure Revenue = SUM ( fact_sales[net_revenue] )
		formatString: #,0
		displayFolder: 1 Sales
		lineageTag: f4c136ae-3bcc-5201-b3e5-e9108e6961d9

	measure 'Gross Sales' = SUM ( fact_sales[gross_sales] )
		formatString: #,0
		displayFolder: 1 Sales
		lineageTag: 8f90fc77-00aa-5780-bf94-6959088d4a3d

	measure Discounts = SUM ( fact_sales[discount_amount] )
		formatString: #,0
		displayFolder: 1 Sales
		lineageTag: b570d729-1fb2-5d3c-b71c-f06c1fd8822d

	measure 'Units Sold' = SUM ( fact_sales[quantity] )
		formatString: #,0
		displayFolder: 1 Sales
		lineageTag: 1ce148cf-6f18-507e-b3b8-e15b62bd591d

	measure Transactions = DISTINCTCOUNT ( fact_sales[transaction_id] )
		formatString: #,0
		displayFolder: 1 Sales
		lineageTag: de7528a5-f964-5d91-a803-8bc47fd654f7

	measure ATV = DIVIDE ( [Revenue], [Transactions] )
		formatString: #,0
		displayFolder: 1 Sales
		lineageTag: 00fc03ab-fad6-5520-b642-5e0113d8e396

	measure 'Units per Basket' = DIVIDE ( [Units Sold], [Transactions] )
		formatString: 0.00
		displayFolder: 1 Sales
		lineageTag: 3deddd0a-c056-59a1-b435-5ffe5e8f640e

	measure 'Revenue Share of Selection' = DIVIDE ( [Revenue], CALCULATE ( [Revenue], ALLSELECTED ( dim_branch ), ALLSELECTED ( dim_product ) ) )
		formatString: 0.0%
		displayFolder: 1 Sales
		lineageTag: a13a60b3-fe24-5b35-82c1-03f013760bcd

	measure COGS = SUM ( fact_sales[cogs] )
		formatString: #,0
		displayFolder: 2 Profitability
		lineageTag: 2d3f3d33-1e7a-5d83-8ce2-d250d91d3f26

	measure 'Gross Profit' = SUM ( fact_sales[gross_profit] )
		formatString: #,0
		displayFolder: 2 Profitability
		lineageTag: 9202fefa-7d5d-596a-b793-d62651c9e698

	measure 'Gross Margin %' = DIVIDE ( [Gross Profit], [Revenue] )
		formatString: 0.00%
		displayFolder: 2 Profitability
		lineageTag: 42c307cb-ea6c-5473-9c78-97c2efb0209e

	measure 'Discount Rate %' = DIVIDE ( [Discounts], [Gross Sales] )
		formatString: 0.00%
		displayFolder: 2 Profitability
		lineageTag: 12e3b666-8d8c-5c26-ad30-3c6fd5e7b297

	measure 'Margin Before Discounts %' = DIVIDE ( [Gross Sales] - [COGS], [Gross Sales] )
		formatString: 0.00%
		displayFolder: 2 Profitability
		lineageTag: 981adc67-4276-5ef9-a81c-883f79b218c2

	measure 'Promo Discount % of Sales' = DIVIDE ( CALCULATE ( [Discounts], fact_sales[price_type] = "Promotion" ), [Gross Sales] )
		formatString: 0.00%
		displayFolder: 2 Profitability
		lineageTag: d36572f8-14f1-53df-9f42-0579f70f318d

	measure 'Non-Promo Discount % of Sales' = DIVIDE ( CALCULATE ( [Discounts], fact_sales[price_type] = "Non-promotional discount" ), [Gross Sales] )
		formatString: 0.00%
		displayFolder: 2 Profitability
		lineageTag: 671c7976-2a00-5e04-8226-a7e944e67888

	measure 'GP Share of Selection' = DIVIDE ( [Gross Profit], CALCULATE ( [Gross Profit], ALLSELECTED ( dim_product ) ) )
		formatString: 0.0%
		displayFolder: 2 Profitability
		lineageTag: 838c494a-7805-586e-ba3c-20a636d8dd5d

	measure 'Chain Gross Margin %' = CALCULATE ( [Gross Margin %], REMOVEFILTERS ( dim_branch ), REMOVEFILTERS ( dim_product ) )
		formatString: 0.00%
		displayFolder: 2 Profitability
		lineageTag: ea6b3e49-70c8-563d-b4ee-b7be79170522

	measure 'Margin vs Chain (pts)' = ( [Gross Margin %] - [Chain Gross Margin %] ) * 100
		formatString: +0.00;-0.00;0.00
		displayFolder: 2 Profitability
		lineageTag: 77e0e1ae-1137-53b0-9141-1a470e2a124d

	measure 'Revenue PY' = CALCULATE ( [Revenue], DATEADD ( dim_date[date], -1, YEAR ) )
		formatString: #,0
		displayFolder: 3 Time intelligence
		lineageTag: 1c24607f-38e6-5086-a89c-f7b7eedec669

	measure 'Revenue YoY %' = IF ( NOT ISBLANK ( [Revenue PY] ), DIVIDE ( [Revenue] - [Revenue PY], [Revenue PY] ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3 Time intelligence
		lineageTag: c4c96e4a-6a6a-5a21-8136-e310b5a5148d

	measure 'Gross Profit PY' = CALCULATE ( [Gross Profit], DATEADD ( dim_date[date], -1, YEAR ) )
		formatString: #,0
		displayFolder: 3 Time intelligence
		lineageTag: 6db68fe8-1188-573b-a3d2-d97d305537a8

	measure 'Gross Profit YoY %' = IF ( NOT ISBLANK ( [Gross Profit PY] ), DIVIDE ( [Gross Profit] - [Gross Profit PY], [Gross Profit PY] ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3 Time intelligence
		lineageTag: 8a0c5ab1-319e-58aa-8819-a6a4ef945944

	measure 'Revenue PM' = CALCULATE ( [Revenue], DATEADD ( dim_date[date], -1, MONTH ) )
		formatString: #,0
		displayFolder: 3 Time intelligence
		lineageTag: fa25a6f6-6404-5368-b776-aab5aa7a2cb1

	measure 'Revenue MoM %' = IF ( NOT ISBLANK ( [Revenue PM] ), DIVIDE ( [Revenue] - [Revenue PM], [Revenue PM] ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3 Time intelligence
		lineageTag: 2e7b29b3-763d-52f6-a2a0-f1050634b35f

	measure 'Revenue Running Total' = CALCULATE ( [Revenue], FILTER ( ALLSELECTED ( dim_date[date] ), dim_date[date] <= MAX ( dim_date[date] ) ) )
		formatString: #,0
		displayFolder: 3 Time intelligence
		lineageTag: 6f9a6081-ab01-57eb-870b-4e3856004002

	measure 'Revenue LFL' = CALCULATE ( [Revenue], dim_branch[is_like_for_like] = TRUE () )
		formatString: #,0
		displayFolder: 3 Time intelligence
		lineageTag: b25cdcc6-da13-513e-b40a-6e464820be71

	measure 'Revenue LFL PY' = CALCULATE ( [Revenue LFL], DATEADD ( dim_date[date], -1, YEAR ) )
		formatString: #,0
		displayFolder: 3 Time intelligence
		lineageTag: 7f632f99-7ab4-57e7-a890-42b7b783778f

	measure 'Revenue LFL YoY %' = IF ( NOT ISBLANK ( [Revenue LFL PY] ), DIVIDE ( [Revenue LFL] - [Revenue LFL PY], [Revenue LFL PY] ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3 Time intelligence
		lineageTag: cf8b9c59-3cfa-57b1-8e05-4a76cd6b5602

	measure 'Avg Daily Revenue' = DIVIDE ( [Revenue], COUNTROWS ( dim_date ) )
		formatString: #,0
		displayFolder: 3 Time intelligence
		lineageTag: 224baa1c-92d2-5086-abc8-c32804bdd658

	measure 'Branch Revenue Rank' = IF ( HASONEVALUE ( dim_branch[branch_short] ), RANKX ( ALLSELECTED ( dim_branch[branch_short] ), [Revenue] ) )
		formatString: #,0
		displayFolder: 4 Rankings
		lineageTag: 6bc2a95f-d8be-5391-970c-d7e8ef8a3409

	measure 'Product GP Rank' = IF ( HASONEVALUE ( dim_product[product_name] ), RANKX ( ALLSELECTED ( dim_product[product_name] ), [Gross Profit] ) )
		formatString: #,0
		displayFolder: 4 Rankings
		lineageTag: 1ad422bb-4a85-5533-96a0-1b45e3f895f6

	measure 'Latest Snapshot Date' = CALCULATE ( MAX ( fact_inventory[snapshot_date] ) )
		formatString: dd mmm yyyy
		displayFolder: 5 Inventory
		lineageTag: c8d5e909-08e0-5097-ad6e-b411642fe8a5

	measure 'Closing Stock Value' =
			VAR d = [Latest Snapshot Date]
			RETURN CALCULATE ( SUM ( fact_inventory[stock_value_at_cost] ), fact_inventory[snapshot_date] = d )
		formatString: #,0
		displayFolder: 5 Inventory
		lineageTag: 570baed1-a1e6-5363-b8e8-898ea9db655b

	measure 'Closing Stock Units' =
			VAR d = [Latest Snapshot Date]
			RETURN CALCULATE ( SUM ( fact_inventory[stock_quantity] ), fact_inventory[snapshot_date] = d )
		formatString: #,0
		displayFolder: 5 Inventory
		lineageTag: 7f2f2122-bb0b-5470-aa72-3a91cc5342c2

	measure 'Avg Stock Value' = AVERAGEX ( VALUES ( fact_inventory[snapshot_date] ), CALCULATE ( SUM ( fact_inventory[stock_value_at_cost] ) ) )
		formatString: #,0
		displayFolder: 5 Inventory
		lineageTag: e946af67-f553-58a3-bdf3-93f2779cebf4

	measure 'Weeks in Selection' = DISTINCTCOUNT ( fact_inventory[snapshot_date] )
		formatString: #,0
		displayFolder: 5 Inventory
		lineageTag: ac7e391b-71a9-5bf2-b301-9507781dfb08

	measure 'Inventory Turnover' = DIVIDE ( [COGS], [Avg Stock Value] ) * DIVIDE ( 52, [Weeks in Selection] )
		formatString: #,0.0
		displayFolder: 5 Inventory
		lineageTag: 2cd6eb99-feb6-5e68-bebd-cc18a4ea1fed

	measure 'Avg Weeks of Stock' = DIVIDE ( 52, [Inventory Turnover] )
		formatString: #,0.0
		displayFolder: 5 Inventory
		lineageTag: 214b177f-29b6-54c6-a48b-dd34d3a54250

	measure 'Stockout Weeks' = CALCULATE ( COUNTROWS ( fact_inventory ), fact_inventory[is_stockout] = TRUE () )
		formatString: #,0
		displayFolder: 5 Inventory
		lineageTag: 311524bf-4b15-537d-86e9-eb658f72fc18

	measure 'Stockout Rate %' = DIVIDE ( [Stockout Weeks], COUNTROWS ( fact_inventory ) )
		formatString: 0.0%
		displayFolder: 5 Inventory
		lineageTag: 157e1c43-2405-5a75-bbc5-424ac1c6e587

	measure 'Slow-Moving Stock Value' = CALCULATE ( SUM ( fact_inventory_position[stock_value_at_cost] ), fact_inventory_position[stock_status] IN { "Slow-moving (>26 wks cover)", "No sales in 12 weeks" } )
		formatString: #,0
		displayFolder: 5 Inventory
		lineageTag: 9b9bfab5-46e1-55da-8329-3d40edc438a0

	measure 'Slow-Moving Share %' = DIVIDE ( [Slow-Moving Stock Value], SUM ( fact_inventory_position[stock_value_at_cost] ) )
		formatString: 0.0%
		displayFolder: 5 Inventory
		lineageTag: bb8519b1-7354-5a25-9cdd-77157a980bb0

	measure 'Chain Weeks of Cover' = DIVIDE ( SUM ( fact_inventory_position[stock_quantity] ), SUM ( fact_inventory_position[avg_weekly_units_12w] ) )
		formatString: #,0.0
		displayFolder: 5 Inventory
		lineageTag: 36554cc4-39ef-5f04-bed4-54a392615a16

	measure 'Promo Revenue' = CALCULATE ( [Revenue], fact_sales[price_type] = "Promotion" )
		formatString: #,0
		displayFolder: 6 Promotions
		lineageTag: f89b2fa8-52d4-5990-ac80-84705708312a

	measure 'Promo Share of Revenue %' = DIVIDE ( [Promo Revenue], [Revenue] )
		formatString: 0.00%
		displayFolder: 6 Promotions
		lineageTag: f4bab80b-a0d3-5b2a-a764-3053b63f9f33

	measure 'Promo Incremental GP' = SUM ( promo_performance[incremental_gp_kes] )
		formatString: #,0
		displayFolder: 6 Promotions
		lineageTag: c2bbc6e7-df4b-5923-95fd-d086e946c84d

	measure 'Promo Discount Cost' = SUM ( promo_performance[discount_cost_kes] )
		formatString: #,0
		displayFolder: 6 Promotions
		lineageTag: da190075-269a-5ba6-aa56-f2faf7c2c64a

	measure 'Incremental GP per KES Discount' = DIVIDE ( [Promo Incremental GP], [Promo Discount Cost] )
		formatString: 0.00
		displayFolder: 6 Promotions
		lineageTag: 88c1d6f4-67ba-5c99-ae90-f020fb8f1236

	measure 'GP-Positive Promotions %' = DIVIDE ( CALCULATE ( COUNTROWS ( promo_performance ), promo_performance[outcome] = "GP-positive" ), COUNTROWS ( promo_performance ) )
		formatString: 0.0%
		displayFolder: 6 Promotions
		lineageTag: 9e895926-8a5c-5ead-ad62-486a88b6e455

	measure 'Promotions Measured' = COUNTROWS ( promo_performance )
		formatString: #,0
		displayFolder: 6 Promotions
		lineageTag: 58c93262-151a-5ed0-b02d-5ef7ad288e2a

	measure 'YoY Colour' = IF ( [Revenue YoY %] < 0, "#eb6834", "#2a78d6" )
		displayFolder: 7 Formatting
		lineageTag: c45c9e58-caf5-564b-8ede-081e725555a5

	measure 'Stockout Colour' = IF ( [Stockout Rate %] > 0.10, "#eb6834", "#2a78d6" )
		displayFolder: 7 Formatting
		lineageTag: 0bce40ce-614a-5a6b-9762-6dde83f7fedd

	measure 'Revenue Growth Y2 vs Y1 %' =
			VAR y2 = CALCULATE ( [Revenue], KEEPFILTERS ( dim_date[date] >= DATE ( 2025, 11, 1 ) ) )
			VAR y1 = CALCULATE ( [Revenue], KEEPFILTERS ( dim_date[date] < DATE ( 2025, 11, 1 ) ) )
			RETURN IF ( SELECTEDVALUE ( dim_branch[is_like_for_like], TRUE () ) && NOT ISBLANK ( y1 ) && NOT ISBLANK ( y2 ), DIVIDE ( y2 - y1, y1 ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3 Time intelligence
		lineageTag: dff5578d-2629-5250-86f7-f7f300320e9c

	measure 'LFL Growth Y2 vs Y1 %' = CALCULATE ( [Revenue Growth Y2 vs Y1 %], dim_branch[is_like_for_like] = TRUE () )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3 Time intelligence
		lineageTag: 04aa0795-6f56-5a59-8c5f-286b3d26d5b4

	column Dummy
		dataType: string
		isHidden
		lineageTag: 004a925a-068a-587f-a444-3cba97fa8421
		summarizeBy: none
		sourceColumn: Dummy

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Dummy = text], {})
				in
				    Source

