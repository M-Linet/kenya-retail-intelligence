EVALUATE
UNION (
    ROW ( "Scope", "No filters", "Revenue", [Revenue], "GP", [Gross Profit], "GM", [Gross Margin %], "Txns", [Transactions], "ATV", [ATV], "Stockout", [Stockout Rate %], "ClosingStock", [Closing Stock Value], "PromoGPpos", [GP-Positive Promotions %] ),
    ROW ( "Scope", "Nyali", "Revenue", CALCULATE ( [Revenue], dim_branch[branch_id] = "BR04" ), "GP", CALCULATE ( [Gross Profit], dim_branch[branch_id] = "BR04" ), "GM", CALCULATE ( [Gross Margin %], dim_branch[branch_id] = "BR04" ), "Txns", CALCULATE ( [Transactions], dim_branch[branch_id] = "BR04" ), "ATV", CALCULATE ( [ATV], dim_branch[branch_id] = "BR04" ), "Stockout", CALCULATE ( [Stockout Rate %], dim_branch[branch_id] = "BR04" ), "ClosingStock", BLANK (), "PromoGPpos", BLANK () ),
    ROW ( "Scope", "Year 2", "Revenue", CALCULATE ( [Revenue], dim_date[date] >= DATE ( 2025, 11, 1 ) ), "GP", CALCULATE ( [Gross Profit], dim_date[date] >= DATE ( 2025, 11, 1 ) ), "GM", BLANK (), "Txns", CALCULATE ( [Transactions], dim_date[date] >= DATE ( 2025, 11, 1 ) ), "ATV", BLANK (), "Stockout", BLANK (), "ClosingStock", BLANK (), "PromoGPpos", BLANK () ),
    ROW ( "Scope", "Staples", "Revenue", CALCULATE ( [Revenue], dim_product[category] = "Staples" ), "GP", CALCULATE ( [Gross Profit], dim_product[category] = "Staples" ), "GM", CALCULATE ( [Gross Margin %], dim_product[category] = "Staples" ), "Txns", BLANK (), "ATV", BLANK (), "Stockout", BLANK (), "ClosingStock", BLANK (), "PromoGPpos", BLANK () ),
    ROW ( "Scope", "Oct26 YoY", "Revenue", CALCULATE ( [Revenue], dim_date[year_month] = "2026-10" ), "GP", CALCULATE ( [Revenue YoY %], dim_date[year_month] = "2026-10" ), "GM", BLANK (), "Txns", BLANK (), "ATV", BLANK (), "Stockout", BLANK (), "ClosingStock", BLANK (), "PromoGPpos", BLANK () )
)